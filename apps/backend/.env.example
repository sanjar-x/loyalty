# =============================================================================
# Loyalty backend — environment configuration template
#
# Copy to ``.env`` and fill in real values for local development. Production
# values are managed in Railway (per-service env vars on backend / worker /
# scheduler / image-ml).
#
# Source of truth for keys: src/bootstrap/config.py (Pydantic Settings).
# Adding a key here without declaring the field in Settings is silently
# ignored at startup.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
PROJECT_NAME=Loyalty
VERSION=1.0.0
ENVIRONMENT=dev                         # dev | test | prod
DEBUG=True
SECRET_KEY=<generated-locally — see backend/docs/secrets-rotation.md §2.1>
# API_V1_STR=/api/v1


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=loyalty

# Connection pool — keep defaults unless under measured contention.
# DB_POOL_SIZE=8
# DB_POOL_MAX_OVERFLOW=4
# DB_POOL_TIMEOUT_SECONDS=30
# DB_POOL_RECYCLE_SECONDS=1800


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDISHOST=127.0.0.1
REDISPORT=6379
REDISUSER=default
REDISPASSWORD=<local-redis-password>          # Railway add-on injects automatically
REDISDATABASE=0


# -----------------------------------------------------------------------------
# RabbitMQ (TaskIQ broker)
# -----------------------------------------------------------------------------
RABBITMQ_PRIVATE_URL=amqp://<user>:<password>@127.0.0.1:5672/  # Railway add-on injects automatically


# -----------------------------------------------------------------------------
# S3 / Object storage (image module)
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=

# Media processing knobs — overridable defaults.
# MEDIA_MAX_FILE_SIZE=52428800            # 50 MB
# MEDIA_PRESIGNED_URL_TTL=300


# -----------------------------------------------------------------------------
# Background removal — Bria RMBG-2.0 (IMG-007)
#
# Web service keeps BG_REMOVAL_ENABLED=false; flip to true ONLY on the
# dedicated `image_ml` worker that installs the [bg-removal] extra
# (torch + transformers + timm + kornia, ~1.6 GB model weights).
# -----------------------------------------------------------------------------
BG_REMOVAL_ENABLED=false
BG_REMOVAL_DEVICE=auto                  # auto | cpu | cuda
BG_REMOVAL_MODEL_CACHE_DIR=/tmp/hf_cache
BG_REMOVAL_WEBP_QUALITY=92


# -----------------------------------------------------------------------------
# Sessions / JWT (web)
# -----------------------------------------------------------------------------
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# SESSION_IDLE_TIMEOUT_MINUTES=30
# SESSION_PERMISSIONS_CACHE_TTL=300
# MAX_ACTIVE_SESSIONS_PER_IDENTITY=5


# -----------------------------------------------------------------------------
# Telegram Bot
# -----------------------------------------------------------------------------
BOT_TOKEN=<from-@BotFather — see backend/docs/secrets-rotation.md §2.3>
THROTTLE_RATE=0.5

# Aiogram FSM TTLs — None means "never expire". Set to seconds to bound.
# FSM_STATE_TTL=86400
# FSM_DATA_TTL=86400


# -----------------------------------------------------------------------------
# Telegram Mini App auth
# -----------------------------------------------------------------------------
# TELEGRAM_INIT_DATA_MAX_AGE=300
# TELEGRAM_REFRESH_TOKEN_EXPIRE_DAYS=7
# TELEGRAM_SESSION_IDLE_TIMEOUT_MINUTES=60


# -----------------------------------------------------------------------------
# Logistics — CDEK
# -----------------------------------------------------------------------------
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
CDEK_TEST_ACCOUNT=
CDEK_TEST_SECURE_PASSWORD=


# -----------------------------------------------------------------------------
# Logistics — Yandex Delivery
#
# Bearer-token берётся в личном кабинете Я.Доставки (раздел "Интеграция").
# Тестовая среда работает только по Москве (МСК).
# Runtime читает host из constants.py по test_mode (no *_BASE_URL keys).
# PLATFORM_STATION_ID — дефолтный склад (точка А); fallback, когда
# origin.metadata запроса не содержит свой station_id.
# -----------------------------------------------------------------------------
YANDEX_DELIVERY_OAUTH_TOKEN=
YANDEX_DELIVERY_PLATFORM_STATION_ID=
YANDEX_DELIVERY_TEST_OAUTH_TOKEN=<from-Yandex-Delivery-cabinet — see secrets-rotation.md §2.5>
YANDEX_DELIVERY_TEST_PLATFORM_STATION_ID=<test-mode-station-uuid>


# -----------------------------------------------------------------------------
# Logistics — DobroPost (cross-border)
#
# DOBROPOST_USE_STUB=true keeps the in-process fake provider until real
# credentials are wired. Flip to false for prod after DOBROPOST_EMAIL /
# DOBROPOST_PASSWORD are set.
# -----------------------------------------------------------------------------
DOBROPOST_USE_STUB=true
DOBROPOST_BASE_URL=https://api.dobropost.com
DOBROPOST_EMAIL=
DOBROPOST_PASSWORD=
DOBROPOST_DEFAULT_TARIFF_ID=1
DOBROPOST_WEBHOOK_TOKEN=
DOBROPOST_ALLOWED_IPS=[]

# Resilience knobs — keep defaults unless tuning.
# DOBROPOST_TIMEOUT_SECONDS=30
# DOBROPOST_TOKEN_REFRESH_BEFORE_SECONDS=3600
# DOBROPOST_RETRY_MAX_ATTEMPTS=4
# DOBROPOST_RETRY_BACKOFF_BASE_SECONDS=0.5
# DOBROPOST_RETRY_BACKOFF_MAX_SECONDS=8.0
# DOBROPOST_CIRCUIT_FAILURE_THRESHOLD=5
# DOBROPOST_CIRCUIT_RESET_TIMEOUT_SECONDS=30


# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=fake                   # fake | yookassa | sbp | tinkoff
PAYMENT_SIMULATION_ENABLED=true
# PAYMENT_AUTH_TTL_DAYS=7               # Visa standard


# -----------------------------------------------------------------------------
# System
# -----------------------------------------------------------------------------
# SYSTEM_USER_ID=00000000-0000-0000-0000-000000000000
