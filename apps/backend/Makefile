.PHONY: test coverage lint format typecheck precommit-install precommit production-smoke openapi-sync openapi-check

test:
	uv run pytest tests/ -v

test-unit:
	uv run pytest tests/unit/ -v

test-integration:
	uv run pytest tests/integration/ -v

test-e2e:
	uv run pytest tests/e2e/ -v

test-architecture:
	uv run pytest tests/architecture/ -v

# Opt-in: spins a real Elasticsearch container per session via testcontainers.
# Slow (≈30s ES startup); excluded from the default suite by the ``es``
# marker. Run before flipping SEARCH_PROVIDER=elasticsearch in any env.
test-es:
	uv run pytest -m es -v

coverage:
	uv run pytest tests/ --cov=project --cov-report=term-missing --cov-report=html

lint:
	uv run ruff check .

format:
	uv run ruff check --fix .
	uv run ruff format .

typecheck:
	uv run ty check

precommit-install:
	cd .. && uv run --project backend pre-commit install --hook-type pre-commit --hook-type pre-push

precommit:
	cd .. && uv run --project backend pre-commit run --all-files

# Simulates the production-clean install + smoke import gates that ship in
# REC-015 (Backend Production Smoke GHA workflow) and REC-019 (the
# pre-push hook). The trap restores the dev venv on exit so a failed
# smoke does not leave the local environment in `--no-dev` state.
# Use directly via `make production-smoke` or via the pre-push hook.
production-smoke:
	@bash -c 'set -e; \
		trap "uv sync --frozen >/dev/null 2>&1" EXIT; \
		echo "→ uv sync --no-dev --frozen"; \
		uv sync --no-dev --frozen; \
		echo "→ smoke import — web entrypoint (create_app)"; \
		uv run python -c "from src.bootstrap.web import create_app; create_app()"; \
		echo "→ smoke import — worker entrypoint (broker)"; \
		uv run python -c "from src.bootstrap.broker import broker"; \
		echo "✓ production-smoke green"'

# Regenerate OpenAPI snapshot for both frontend apps.
# Builds the FastAPI ``app`` in-process (no HTTP server needed), dumps
# the full schema to ``apps/backend/openapi.json``, the admin-only subset
# to ``backend-mini.json``, copies the full schema into both
# ``apps/frontend/admin/openapi/`` (admin uses Orval) and
# ``apps/frontend/mini-app/openapi.json`` (mini-app uses rtk-query-codegen
# + openapi-typescript).
# Run whenever an admin endpoint, request schema, or response schema
# changes so both frontend codegens stay in sync.
openapi-sync:
	@uv run python -c "\
import json, copy, pathlib;\
from src.bootstrap.web import create_app;\
spec = create_app().openapi();\
admin = {p: ops for p, ops in spec['paths'].items() if p.startswith('/api/v1/admin/')};\
mini = {'openapi': spec['openapi'], 'info': {**spec['info'], 'title': spec['info']['title'] + ' (Admin Subset)'}, 'paths': admin, 'components': spec.get('components', {})};\
pathlib.Path('openapi.json').write_text(json.dumps(spec, indent=2, ensure_ascii=False), encoding='utf-8');\
pathlib.Path('/tmp/openapi-mini.json').write_text(json.dumps(mini, indent=2, ensure_ascii=False), encoding='utf-8');\
print(f'→ {len(spec[\"paths\"])} paths total, {len(admin)} admin')"
	@cp openapi.json ../frontend/admin/openapi/backend.json
	@cp /tmp/openapi-mini.json ../frontend/admin/openapi/backend-mini.json
	@cp openapi.json ../frontend/mini-app/openapi.json
	@echo "✓ openapi snapshot copied to frontend/admin/openapi/ and frontend/mini-app/openapi.json"

# Q5 drift-guard. Regenerate openapi.json into a temp file and compare
# against every committed copy (backend, admin × 2, mini-app). Exits
# non-zero with a precise diff hint when any copy is out of sync — so
# the buy-now-style «backend merged, mini-app codegen forgotten» mistake
# fails fast at pre-push instead of in production. Frontend codegen
# itself (RTK + openapi-typescript) is regenerated by the FE workflow
# (``cd apps/frontend/mini-app && npm run api:gen && npm run api:types``);
# this target only enforces that the *source* openapi.json is current.
openapi-check:
	@bash -c 'set -e; \
		TMP=$$(mktemp -d); \
		trap "rm -rf $$TMP" EXIT; \
		OPENAPI_TMP_DIR="$$TMP" uv run python -c "\
import json, os, pathlib;\
from src.bootstrap.web import create_app;\
out = pathlib.Path(os.environ[\"OPENAPI_TMP_DIR\"]);\
spec = create_app().openapi();\
admin = {p: ops for p, ops in spec[\"paths\"].items() if p.startswith(\"/api/v1/admin/\")};\
mini = {\"openapi\": spec[\"openapi\"], \"info\": {**spec[\"info\"], \"title\": spec[\"info\"][\"title\"] + \" (Admin Subset)\"}, \"paths\": admin, \"components\": spec.get(\"components\", {})};\
(out / \"openapi.json\").write_text(json.dumps(spec, indent=2, ensure_ascii=False), encoding=\"utf-8\");\
(out / \"openapi-mini.json\").write_text(json.dumps(mini, indent=2, ensure_ascii=False), encoding=\"utf-8\")"; \
		failed=0; \
		check() { \
			local label=$$1 src=$$2 dst=$$3; \
			if ! diff -q "$$src" "$$dst" >/dev/null 2>&1; then \
				echo "✗ $$label drift: $$dst"; \
				failed=1; \
			fi; \
		}; \
		check "backend/openapi.json" "$$TMP/openapi.json" "openapi.json"; \
		check "admin/openapi/backend.json" "$$TMP/openapi.json" "../frontend/admin/openapi/backend.json"; \
		check "admin/openapi/backend-mini.json" "$$TMP/openapi-mini.json" "../frontend/admin/openapi/backend-mini.json"; \
		check "mini-app/openapi.json" "$$TMP/openapi.json" "../frontend/mini-app/openapi.json"; \
		if [ $$failed -ne 0 ]; then \
			echo; \
			echo "Fix: run from apps/backend/ —"; \
			echo "  make openapi-sync"; \
			echo "  cd ../frontend/mini-app && npm run api:gen && npm run api:types"; \
			echo "  cd ../admin && npm run api:gen   # (or your admin codegen command)"; \
			echo "then stage the regenerated files and re-push."; \
			exit 1; \
		fi; \
		echo "✓ openapi snapshots in sync (backend + admin + mini-app)"'
