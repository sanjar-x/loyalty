# Always pin exact versions on `npm install <pkg>`.
save-exact=true

# Refuse to install on Node/npm versions that don't match `engines`.
engine-strict=true

# Quiet npm chatter that adds noise to CI logs.
fund=false
audit-level=moderate

# Faster reproducible CI installs (`npm ci` already enforces lockfile, this
# blocks accidental drift in dev too).
package-lock=true

# Hoisting / strict semantics — keep parity with what CI does.
prefer-online=false
