# Dockerfile.image-ml — dedicated image for the `image-ml-worker` Railway service.
#
# Differs from the main Dockerfile only in installing the optional
# `[bg-removal]` extra (torch + transformers + timm + kornia). The
# CPU-only torch wheel is selected at build time via the `UV_TORCH_BACKEND=cpu`
# env var that Railway injects from the service settings — keeps the
# image around ~200 MB heavier instead of the ~3 GB CUDA default.
#
# Web / worker / scheduler services keep using the lean main Dockerfile.

FROM python:3.14-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_NO_DEV=1
ENV PATH="/app/.venv/bin:$PATH"

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./

# Install deps + optional [bg-removal] extra. CPU-only torch wheel
# selected via the runtime env var UV_TORCH_BACKEND=cpu (set on the
# Railway service); without that override uv would default to the
# multi-GB CUDA wheel.
RUN uv sync --frozen --no-dev --no-install-project --extra bg-removal

COPY . .
RUN uv sync --frozen --no-dev --no-editable --extra bg-removal

RUN chmod +x scripts/entrypoint.sh

CMD ["./scripts/entrypoint.sh"]
