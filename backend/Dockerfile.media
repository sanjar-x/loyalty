# Dockerfile.media — dedicated image for the `media-worker` Railway service.
#
# Differs from the main Dockerfile only in installing the optional
# `[bg-removal]` extra (torch + transformers + timm + kornia). The
# CPU-only torch wheel is pinned via the build-time ENV below — Railway's
# runtime service variables are NOT propagated into the build phase for
# Dockerfile builders, so relying on a service-level UV_TORCH_BACKEND=cpu
# silently fell back to the default CUDA wheel (~2.5 GB heavier than the
# CPU variant and useless on the Railway nodes which have no GPU).
#
# web / core-worker / scheduler services keep using the lean main Dockerfile.

FROM python:3.14-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_NO_DEV=1
ENV PATH="/app/.venv/bin:$PATH"


WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./

# Install deps + optional [bg-removal] extra. CPU-only torch is selected
# via the ENV above (build-time, not runtime — see comment).
RUN uv sync --frozen --no-dev --no-install-project --extra bg-removal

COPY . .
RUN uv sync --frozen --no-dev --no-editable --extra bg-removal

RUN chmod +x scripts/entrypoint.sh

CMD ["./scripts/entrypoint.sh"]
