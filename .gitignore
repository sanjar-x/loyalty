# Hypothesis stateful-test cache + similar Python build/test caches
# anywhere in the workspace (the legacy ``backend/.hypothesis/`` pattern
# became inert after backend/ moved to apps/backend/ — ADR-008 / Phase 1).
**/.hypothesis/
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
**/htmlcov/
**/coverage.xml
**/.coverage

# Wheels / build artefacts at any depth
**/dist/

# Standalone experiments (e.g. rmbg/) — they have their own git repos and
# pyproject and are NOT workspace members.
/rmbg/

# ── Claude Code (local-only files) ──
**/.claude/settings.local.json
**/.claude/scheduled_tasks.lock

# ── GSD baseline (auto-generated) ──
.gsd
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
.env
.env.*
!.env.example
node_modules/
.next/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
target/
vendor/
*.log
coverage/
.cache/
tmp/
